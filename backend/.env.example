# Variables del backend; copia este archivo a backend/.env y completa las claves.
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000
FLASK_DEBUG=false

# NVIDIA: chat de IA y síntesis de voz.
NVIDIA_API_KEY=
# Requerido para usar TTS; function-id del endpoint de NVIDIA Riva.
NVIDIA_TTS_FUNCTION_ID=

# Opcional: clave de CryptoCompare para noticias.
CRYPTOCOMPARE_API_KEY=

# Búsqueda web: DuckDuckGo primero y SerpApi como respaldo.
# Usa "serpapi" para priorizar SerpApi.
WEB_SEARCH_PROVIDER=duckduckgo
SERPAPI_API_KEY=

# PostgreSQL. Use localhost for running the backend directly, or override
# POSTGRES_HOST=postgres in Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=

# Capa Redis: el feeder worker es el UNICO proceso que consulta los exchanges y
# publica en Redis; la API, los sockets y el agente de chat solo leen Redis.
# memory -> sin Redis (cache en memoria + polling, como antes).
# redis  -> requiere MARKET_ROLE y el servicio feeder corriendo.
MARKET_BACKEND=memory
# Rol del proceso: api (lector) o feeder (unico escritor).
MARKET_ROLE=api
REDIS_URL=redis://localhost:6379/0
# Segundos entre latidos de diagnostico del feeder.
FEEDER_HEARTBEAT_SECONDS=60
REDIS_MAX_CONNECTIONS=24
# Segundos que espera la API al feeder cuando una sala aun no esta sembrada
# en Redis. Un seed en frio medido en Binance tarda ~16 s.
STORE_SEED_WAIT_SECONDS=20
# Vida del lease de una sala (la API lo renueva cada ROOM_HEARTBEAT_SECONDS);
# si un nodo muere sin soltarla, el feeder deja de recalcularla al expirar.
ROOM_LEASE_SECONDS=90
ROOM_HEARTBEAT_SECONDS=30
