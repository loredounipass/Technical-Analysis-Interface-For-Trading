# ============================================
# COPIA este archivo a .env y ajusta los valores
# ============================================

# --- FRONTEND (se incrustan en el build) ---
# URL publica del backend (con /api al final)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
# URL publica del backend para WebSocket (sin /api)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# --- BACKEND ---
# Origenes permitidos por CORS, separados por coma (URL del frontend)
ALLOWED_ORIGINS=http://localhost:3000
# Opcional: activar debug del backend (true/false)
FLASK_DEBUG=false

# --- API KEYS OPCIONALES ---
NVIDIA_API_KEY=
CRYPTOCOMPARE_API_KEY=
# Opcional: function-id del endpoint cloud de NVIDIA Riva para TTS (tiene default)
NVIDIA_TTS_FUNCTION_ID=

# --- WEB SEARCH (backend/services/web_search.py) ---
# Recomendado: Google Custom Search JSON API. Free tier = 100 queries/dia.
# Setup: (1) crear Search Engine en https://programmablesearchengine.google.com/
#            y habilitar "Search the entire web", copiar el Search engine ID (cx)
#      (2) habilitar Custom Search API en
#            https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#      (3) crear API key en https://console.cloud.google.com/apis/credentials
# Sin estas dos variables el backend cae automaticamente a DuckDuckGo (rate-limited).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
