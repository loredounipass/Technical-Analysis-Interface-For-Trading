# ============================================
# COPIA este archivo a .env y ajusta los valores
# ============================================

# --- FRONTEND (se incrustan en el build) ---
# URL publica del backend (con /api al final)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
# URL publica del backend para WebSocket (sin /api)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# --- BACKEND ---
# Origenes permitidos por CORS, separados por coma (URL del frontend)
ALLOWED_ORIGINS=http://localhost:3000
# Opcional: activar debug del backend (true/false)
FLASK_DEBUG=false

# --- API KEYS OPCIONALES ---
NVIDIA_API_KEY=
CRYPTOCOMPARE_API_KEY=
# Opcional: function-id del endpoint cloud de NVIDIA Riva para TTS (tiene default)
NVIDIA_TTS_FUNCTION_ID=

# --- WEB SEARCH (backend/services/web_search.py) ---
# Dos proveedores: DuckDuckGo (scraping, gratis, sin cuota) y SerpApi (Google
# Search API, free tier 250 busquedas/mes).
# Orden via WEB_SEARCH_PROVIDER:
#   duckduckgo (default, ideal LOCAL): DDG primero, SerpApi de respaldo (ahorra cuota).
#   serpapi    (ideal RENDER/NUBE): SerpApi primero, porque DDG esta siempre bloqueado
#              desde IP de datacenter; evita el hang de ~25s reintentando DDG.
WEB_SEARCH_PROVIDER=duckduckgo
# Setup SerpApi: (1) registrarse en https://serpapi.com
#        (2) copiar la private API key de https://serpapi.com/manage-api-key
#        (3) pegarla aqui. Si esta vacio, solo se usa DuckDuckGo.
SERPAPI_API_KEY=

